# Copy to .env and fill in. Never commit .env.
# Values marked NOT GUESSABLE block real behaviour when absent -- that is
# deliberate. Do not substitute a placeholder to get past a check.

# ---------------------------------------------------------------- database
# Host port 5433 so a native Postgres install can coexist. Inside compose the
# service is reachable as db:5432.
DATABASE_URL=postgresql+psycopg://outbound:outbound@localhost:5433/outbound

# ------------------------------------------------------------------ company
COMPANY_NAME=Audria
WHAT_WE_SELL=Meeting memory: the commitments made, decisions taken, and context that evaporates between conversations.

# NOT GUESSABLE. CAN-SPAM requires a physical postal address in every email.
# Sequence activation is blocked in code until this is set.
PHYSICAL_ADDRESS=

# ----------------------------------------------------------------- timezones
TIMEZONE_OPS=Asia/Kolkata
TIMEZONE_SEND=America/New_York

# ------------------------------------------------------------------ capacity
# NOT GUESSABLE. Until these are set, /capacity reports "not configured"
# rather than a number. See section 6: capacity = domains x mailboxes x sends.
SENDING_DOMAINS=
MAILBOXES_PER_DOMAIN=
# Keep low. Cold mailboxes die above ~50/day; the schema caps daily_cap at 50.
SENDS_PER_MAILBOX_DAY=
# Leave blank until capacity is known -- the target is decided against it.
DAILY_SOURCING_TARGET=

# ------------------------------------------------------------------ decisions
# positive_reply_rate | reply_rate | meeting_rate
# meeting_rate needs ~4x the sample; track it as a guardrail, do not decide on it.
NORTH_STAR_METRIC=positive_reply_rate
# Default no: a human approves each launch.
AUTO_LAUNCH_CAMPAIGNS=no

# -------------------------------------------------------------------- apollo
APOLLO_API_KEY=
# Runs abort rather than exceed this. Raising it is a deliberate act.
APOLLO_CREDIT_CEILING_PER_RUN=200

# ------------------------------------------------------------------- hubspot
HUBSPOT_PORTAL_ID=
# Private app token: Settings -> Integrations -> Private Apps. Shown once.
# Scopes: crm.objects.{contacts,companies}.{read,write} and
#         crm.schemas.{contacts,companies}.{read,write}
# The schemas.* scopes are what allow creating custom properties by API.
HUBSPOT_PRIVATE_APP_TOKEN=
# Shared secret for validating webhook signatures.
HUBSPOT_WEBHOOK_SECRET=

# ----------------------------------------------------------------- smartlead
SMARTLEAD_API_KEY=

# --------------------------------------------------------------------- drive
DRIVE_SEQUENCE_FOLDER=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------- signals
# manual | x_api | apify
# There is no official API for searching public LinkedIn posts; every route is
# a scraper or a reseller of one. manual is a legitimate starting position.
SIGNAL_PROVIDER=manual
X_API_BEARER_TOKEN=
APIFY_TOKEN=
# Required when SIGNAL_PROVIDER=apify. A token alone must never self-enable
# scraping, so the actor id is passed explicitly or the provider refuses to load.
APIFY_ACTOR_ID=

# --------------------------------------------------------------------- misc
LOG_LEVEL=INFO
ENVIRONMENT=development
